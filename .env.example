# Robot identity and connection. Copy to `.env` (not versioned) and adapt.
# Environment variables and the .env file replace the values of
# configs/robot.yaml. Values read on Monolithoid's NAO on 2026-11-04:
#   qicli call ALSystem.systemVersion   -> 2.1.4.13
#   qicli call ALSystem.robotName       -> nao
#   qicli call ALMotion.getRobotConfig  -> naoH25, head/body/arms VERSION_40 (NAO V4)
#   python --version (on the robot)     -> Python 2.7.3

# The robot address (IP or DNS name) is asked for by the interface (Robot tab).
# NAO_IP is only a pre-filled value, and is used by command-line commands (--robot wins).
NAO_IP=                      # e.g. 192.168.1.10 or nao.local
NAO_PORT=9559
NAO_NAME=nao                 # ALSystem.robotName; the calibration is tied to this name
NAO_MODEL=naoH25             # ALMotion.getRobotConfig -> Model Type
NAO_HEAD_VERSION=VERSION_40
NAO_BODY_VERSION=VERSION_40
NAOQI_VERSION=2.1.4.13       # ALSystem.systemVersion
NAO_PYTHON=2.7.3             # embedded Python: the bridge bridge/naoqi_bridge.py stays 2.7-compatible

# NAOqi bridge (bridge/naoqi_bridge.py).
# robot: the bridge runs on the NAO (python naoqi_bridge.py --on-robot), nothing to install;
#         the interface connects to it at the robot's address.
# pc   : the bridge runs on this PC and requires the NAOqi Python SDK (pynaoqi, Python 2.7).
NAO_BRIDGE_LOCATION=robot
NAO_BRIDGE_HOST=127.0.0.1    # used only if NAO_BRIDGE_LOCATION=pc
NAO_BRIDGE_PORT=9600
NAO_BRIDGE_WATCHDOG_S=0.6

# Default adapter: sim | bridge
NAO_ADAPTER=sim

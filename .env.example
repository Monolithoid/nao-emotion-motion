# Identité et connexion du robot. Copier en `.env` (non versionné) et adapter.
# Les variables d'environnement et le fichier .env remplacent les valeurs de
# configs/robot.yaml. Valeurs relevées sur le NAO de Joachim le 2026-11-04 :
#   qicli call ALSystem.systemVersion   -> 2.1.4.13
#   qicli call ALSystem.robotName       -> nao
#   qicli call ALMotion.getRobotConfig  -> naoH25, tête/corps/bras VERSION_40 (NAO V4)
#   python --version (sur le robot)     -> Python 2.7.3

NAO_IP=192.168.1.10          # À RENSEIGNER : adresse IP du robot (commande `hostname -I` sur le robot)
NAO_PORT=9559
NAO_NAME=nao                 # ALSystem.robotName ; la calibration est liée à ce nom
NAO_MODEL=naoH25             # ALMotion.getRobotConfig -> Model Type
NAO_HEAD_VERSION=VERSION_40
NAO_BODY_VERSION=VERSION_40
NAOQI_VERSION=2.1.4.13       # ALSystem.systemVersion
NAO_PYTHON=2.7.3             # Python embarqué : le pont bridge/naoqi_bridge.py reste compatible 2.7

# Pont NAOqi (bridge/naoqi_bridge.py) : machine où il tourne et port d'écoute
NAO_BRIDGE_HOST=127.0.0.1
NAO_BRIDGE_PORT=9600
NAO_BRIDGE_WATCHDOG_S=0.6

# Adaptateur par défaut : sim | bridge
NAO_ADAPTER=sim
